         activan expresamente por variables de entorno (ver TestGates.cs). Nunca forman parte de la ejecucion normal de pruebas. -->
    <ProjectReference Include="..\..\CjERP.Infrastructure\CjERP.Infrastructure.csproj" />
    <ProjectReference Include="..\..\CjERP.Application\CjERP.Application.csproj" />
    <ProjectReference Include="..\..\CjERP.Shared\CjERP.Shared.csproj" />
    <!-- CjERP.Api: la prueba de identidad usa el controlador REAL (aporta el framework ASP.NET) -->
